HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
SITE_MODE=combined
SOLANA_RPC_URL=http://127.0.0.1:8899
DATABASE_PATH=./rillvane.sqlite
REGISTRY_PATH=./ops/registry.json
NODE_ENV=development
EXECUTION_MODE=protocol
WORKER_ENABLED=true
FAUCET_USDC=10000
FAUCET_RLVN=100

# Operator routes. Required in production (32+ characters).
# OPS_TOKEN=

# Distinct authority keypairs. Never ship these in dist/.
# UPGRADE_AUTHORITY=
# ORACLE_AUTHORITY=
# FAUCET_AUTHORITY=
# KEEPER_AUTHORITY=

# Optional second HTTPS read RPC. Localhost HTTP is allowed for the validator.
# SOLANA_RPC_URLS=http://127.0.0.1:8899
