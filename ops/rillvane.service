[Unit]
Description=Rillvane app and API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rillvane
Group=rillvane
WorkingDirectory=/srv/rillvane
EnvironmentFile=/srv/rillvane/.env
ExecStart=/usr/bin/node /srv/rillvane/backend/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rillvane

[Install]
WantedBy=multi-user.target
